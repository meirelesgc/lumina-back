{
  "$description": "LUMINA design tokens. 'origem: guia' = valor extraído do PDF do guia de marca; 'origem: derivado' = adicionado para uso em documentos/interfaces (não consta no guia).",
  "color": {
    "brand": {
      "laranja":       { "value": "#f8580a", "origem": "guia", "uso": "Cor principal da marca, fundos de capa, títulos grandes, destaques" },
      "ouro":          { "value": "#d9ae21", "origem": "guia", "uso": "Cor secundária, blocos e formas gráficas" },
      "teal":          { "value": "#0e90a0", "origem": "guia", "uso": "Cor secundária, tags, blocos e formas gráficas" },
      "claro":         { "value": "#efefef", "origem": "guia", "uso": "Fundo claro padrão (no lugar do branco puro) e texto sobre cores da marca" }
    },
    "brand-tons": {
      "laranja-claro": { "value": "#f77948", "origem": "guia", "uso": "Linhas e grades decorativas sobre laranja" },
      "ouro-escuro":   { "value": "#b58d1d", "origem": "guia", "uso": "Formas gráficas sobre ouro" },
      "teal-escuro":   { "value": "#0b6970", "origem": "guia", "uso": "Formas gráficas sobre teal" }
    },
    "mono": {
      "cinza-1": { "value": "#b2b2b2", "origem": "guia" },
      "cinza-2": { "value": "#9d9d9c", "origem": "guia" },
      "cinza-3": { "value": "#878787", "origem": "guia" },
      "cinza-4": { "value": "#706f6f", "origem": "guia", "uso": "Versão monocromática do logo" }
    },
    "derivado": {
      "tinta":         { "value": "#2b2b2b", "origem": "derivado", "uso": "Texto corrido e tabelas (contraste 12,3:1 sobre #efefef)" },
      "laranja-texto": { "value": "#b04406", "origem": "derivado", "uso": "Laranja escurecido para texto pequeno (contraste 5,0:1 sobre #efefef)" },
      "teal-texto":    { "value": "#0b6970", "origem": "guia", "uso": "Mesmo valor do teal-escuro; usar para links e texto pequeno (5,6:1 sobre #efefef)" },
      "papel":         { "value": "#ffffff", "origem": "derivado", "uso": "Fundo de cartões sobre #efefef e impressão econômica" },
      "linha":         { "value": "#d6d6d6", "origem": "derivado", "uso": "Fios e bordas de tabela" }
    }
  },
  "font": {
    "titulo": { "family": "Barlow", "weights": [500, 600, 700], "fallback": "'Arial Narrow', Arial, sans-serif", "uso": "Títulos" },
    "corpo":  { "family": "Lexend", "weights": [300, 400, 600, 700, 800], "fallback": "Arial, sans-serif", "uso": "Corpo, parágrafos, web" }
  },
  "fontSize": {
    "xs": "8pt", "sm": "9pt", "base": "10pt", "md": "11pt", "lg": "14pt",
    "h3": "14pt", "h2": "20pt", "h1": "30pt", "display": "56pt"
  },
  "lineHeight": { "titulo": 1.05, "corpo": 1.55 },
  "space": { "1": "2mm", "2": "4mm", "3": "6mm", "4": "8mm", "5": "12mm", "6": "16mm", "7": "24mm" },
  "radius": { "sm": "2mm", "md": "4mm", "lg": "8mm", "xl": "14mm", "pill": "999px" },
  "stroke": { "fino": "0.25mm", "normal": "0.4mm" },
  "page": {
    "formato": "A4",
    "margem": { "topo": "20mm", "base": "20mm", "interna": "34mm", "externa": "16mm" },
    "trilho": { "largura": "11mm", "esquerda": "10mm", "raio": "2mm" }
  }
}
